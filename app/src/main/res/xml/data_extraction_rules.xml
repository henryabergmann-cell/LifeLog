<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). PLAN.md D4: data never goes to Google cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- The cached subscription entitlement is re-verified on the new device instead. -->
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
