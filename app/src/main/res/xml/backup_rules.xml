<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8-11 (API 26-30). These rules apply to cloud backup and device transfer alike, so
    everything is excluded to keep data off Google's servers (PLAN.md D4).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
